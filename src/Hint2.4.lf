target C {
  platform: "RP2040",
  single-threaded: true,
  keepalive: true
}

import Display from "lib/Display.lf"

preamble {=
  #include <stdio.h>
  #include <stdlib.h>
  #include <stdint.h>
  #include <hardware/gpio.h>
  #include <hardware/irq.h>
  #include <hardware/structs/timer.h>
  #include <pico/stdlib.h>

  #define ALARM_NUM 0
=}

main reactor {
  display = new Display()

  preamble {=
    typedef void (*virtual_timer_callback_t)(void);

    typedef struct node_t {
      // Absolute hardware-timer expiration time in microseconds.
      uint32_t timer_value;

      // Function to call when this virtual timer expires.
      virtual_timer_callback_t callback;

      // Pointer to the next timer in the sorted linked list.
      struct node_t* next;
    } node_t;

    // The head is always the earliest timer deadline.
    static node_t* linked_list = NULL;

    // State used by the LED callback.
    static bool led_state = false;

    // Insert node into the linked list in increasing timer_value order.
    void list_insert_sorted(node_t* node) {
      if (linked_list == NULL) {
        node->next = NULL;
        linked_list = node;
      } else if (linked_list->timer_value > node->timer_value) {
        node->next = linked_list;
        linked_list = node;
      } else {
        node_t* prev_node = linked_list;
        node_t* curr_node = linked_list->next;

        while (curr_node != NULL &&
               curr_node->timer_value < node->timer_value) {
          prev_node = curr_node;
          curr_node = curr_node->next;
        }

        prev_node->next = node;
        node->next = curr_node;
      }
    }

    // Remove a particular node from the linked list.
    void list_remove(node_t* node) {
      if (linked_list == NULL) {
        return;
      }

      if (linked_list == node) {
        linked_list = linked_list->next;
      } else {
        node_t* prev_node = linked_list;
        node_t* curr_node = linked_list->next;

        while (curr_node != NULL && curr_node != node) {
          prev_node = curr_node;
          curr_node = curr_node->next;
        }

        if (curr_node != NULL) {
          prev_node->next = curr_node->next;
        }
      }
    }

    // Remove and return the first node, which is the earliest timer.
    node_t* list_remove_first() {
      node_t* head = linked_list;

      if (head != NULL) {
        linked_list = head->next;
      }

      return head;
    }

    // Toggle the active-low LED.
    void toggle_led(void) {
      led_state = !led_state;
      gpio_put(PICO_DEFAULT_LED_PIN, !led_state);
    }

    // Interrupt handler for TIMER_IRQ_0, corresponding to ALARM0.
    void lab5_timer_irq_handler(void) {
      // INTR is write-one-to-clear.
      timer_hw->intr = 1u << ALARM_NUM;

      // The list head is the timer that should expire now.
      node_t* expired_timer = list_remove_first();

      if (expired_timer == NULL) {
        return;
      }

      // Save the callback before freeing the node.
      virtual_timer_callback_t callback = expired_timer->callback;

      if (callback != NULL) {
        callback();
      }

      // One-shot timer nodes are no longer needed.
      free(expired_timer);

      // Schedule the next earliest virtual timer, if one exists.
      if (linked_list != NULL) {
        timer_hw->alarm[ALARM_NUM] = linked_list->timer_value;
      }
    }

    // Configure ALARM0 and its processor interrupt.
    void virtual_timer_init(void) {

      // Enable ALARM0 in the timer peripheral.
      timer_hw->inte |= 1u << ALARM_NUM;
      
      irq_set_exclusive_handler(
          TIMER_IRQ_0,
          lab5_timer_irq_handler
      );



      // Enable TIMER_IRQ_0 in the NVIC.
      irq_set_enabled(TIMER_IRQ_0, true);
    }

    // Create a one-shot virtual timer.
    uint32_t virtual_timer_start(
        uint32_t microseconds,
        virtual_timer_callback_t cb
    ) {
      node_t* node = malloc(sizeof(node_t));

      if (node == NULL) {
        return 0;
      }

      // Store an absolute deadline, not just a relative delay.
      node->timer_value = timer_hw->timelr + microseconds;
      node->callback = cb;
      node->next = NULL;

      // Insert the new timer in deadline order.
      list_insert_sorted(node);

      // The hardware alarm always tracks the earliest deadline.
      timer_hw->alarm[ALARM_NUM] = linked_list->timer_value;

      // The address is a unique ID for later cancellation support.
      return (uint32_t)(uintptr_t)node;
    }

    // This function is implemented in Checkoff 9.2.5.
    uint32_t virtual_timer_start_repeated(
        uint32_t microseconds,
        virtual_timer_callback_t cb
    ) {
      (void)microseconds;
      (void)cb;
      return 0;
    }

    // This function is implemented in Checkoff 9.2.6.
    void virtual_timer_cancel(uint32_t timer_id) {
      (void)timer_id;
    }
  =}

  // Used only to display the hardware counter every second.
  timer print_hw_timer(0, 1000 ms)

  reaction(startup) {=
    // Enable USB serial output for printf().
    stdio_init_all();

    // Initialize the active-low LED.
    gpio_init(PICO_DEFAULT_LED_PIN);
    gpio_set_dir(PICO_DEFAULT_LED_PIN, GPIO_OUT);
    gpio_put(PICO_DEFAULT_LED_PIN, true);

    // Configure ALARM0 and TIMER_IRQ_0.
    virtual_timer_init();

    // Create several one-shot virtual timers.
    virtual_timer_start(1000000, toggle_led);
    virtual_timer_start(2000000, toggle_led);
    virtual_timer_start(3000000, toggle_led);
    virtual_timer_start(4000000, toggle_led);
  =}

  reaction(print_hw_timer) -> display.line0 {=
    static char text[17];

    // Read the lower 32 bits of the hardware timer in microseconds.
    uint32_t time_us = timer_hw->timelr;

    snprintf(
        text,
        sizeof(text),
        "%lu us",
        (unsigned long)time_us
    );

    lf_set(display.line0, text);
  =}
}